# 环境变量配置文件示例
# 复制此文件为 .env 并填入您的实际配置值（与 server.py 同目录）
# Example environment variables file
# Copy this file to .env and fill in your actual configuration values

# 会话与登录（Flask session，Cookie 名默认 lx_session）
# SECRET_KEY：请用 python -c "import secrets; print(secrets.token_hex(32))" 生成，部署后勿频繁更换
# SESSION_COOKIE_SECURE：仅当全站 HTTPS 时设为 1；若用 http:// 访问必须为 0，否则浏览器不发 Cookie、接口一直 401
SECRET_KEY=your-long-random-secret-key-here
SESSION_COOKIE_SECURE=0
# SESSION_COOKIE_SAMESITE=Lax
# AUTH_TOKEN_TTL=604800

# DeepSeek API 配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions



# 应用配置
APP_DEBUG=false
APP_TIMEOUT=30000

# 模型配置
MODEL_NAME=deepseek-chat
MAX_TOKENS=1000
TEMPERATURE=0.7

# Hiagent 代理配置
HIAGENT_URL=https://coze.nankai.edu.cn/api/proxy/api/v1
HIAGENT_API_KEY=your-hiagent-api-key-here
HIAGENT_APP_ID=your-hiagent-app-id-here
HIAGENT_USE_BEARER=true